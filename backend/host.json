{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    },
    "logLevel": { "default": "Information", "saludcerca.audit": "Information" }
  },
  "extensions": {
    "http": { "routePrefix": "" },
    "serviceBus": { "maxConcurrentCalls": 16, "autoCompleteMessages": true }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
